# ============================================================================
# TrueConf Zabbix Relay Bot — пример конфигурации
#
#   cp .env.example .env
#   # заполните TRUECONF_SERVER и TRUECONF_PASSWORD
# ============================================================================

# ----------------------------------------------------------------------------
# СЕРВЕР TRUECONF
# ----------------------------------------------------------------------------
TRUECONF_SERVER=trueconf.example.com
TRUECONF_PORT=443
TRUECONF_TOKEN_URL=https://trueconf.example.com/bridge/api/client/v1/oauth/token
TRUECONF_CLIENT_ID=chat_bot

# Сервисная учётная запись бота
TRUECONF_USERNAME=trueconf-bot
TRUECONF_PASSWORD=

# Проверка TLS-сертификата:
#   true         — по системному хранилищу (нужен корпоративный CA в системе)
#   false        — не проверять (самоподписанный сертификат)
#   /path/ca.pem — по указанному CA-бандлу (рекомендуется)
VERIFY_SSL=true

# Чат по умолчанию (можно задать позже командой /default в нужном чате)
GROUP_CHAT_ID=

# ----------------------------------------------------------------------------
# АДМИНИСТРИРОВАНИЕ В ЧАТЕ
# ----------------------------------------------------------------------------
# strict | whitelist | open
ADMIN_MODE=strict
# Администраторы через запятую. Эти записи нельзя удалить из бота.
ADMIN_IDS=admin@example.com

# ----------------------------------------------------------------------------
# ВЕБ-СЕРВЕР И ПАНЕЛЬ
# ----------------------------------------------------------------------------
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
# Внешний адрес панели — из него строится redirect_uri для Keycloak
WEBUI_PUBLIC_URL=https://tcbot.example.com

# ----------------------------------------------------------------------------
# АВТОРИЗАЦИЯ ПАНЕЛИ
# ----------------------------------------------------------------------------
# both     — SSO Keycloak + локальный администратор (рекомендуется)
# keycloak — только Keycloak
# local    — только локальный администратор
# token    — статический токен (для скриптов)
# none     — без авторизации (только закрытый контур)
WEBUI_AUTH=both

# Статический токен: если задан, работает в любом режиме через заголовок
# X-WebUI-Token (удобно для healthcheck и автоматизации)
WEBUI_TOKEN=

# ----------------------------------------------------------------------------
# SSO (Keycloak)
# ----------------------------------------------------------------------------
SSO_SERVER_URL=https://auth.example.com
SSO_REALM=your-realm
SSO_CLIENT_ID=tcbot-admin
# Для public-клиента с PKCE секрет не нужен
SSO_CLIENT_SECRET=
# Переопределение redirect_uri (по умолчанию WEBUI_PUBLIC_URL/auth/callback)
SSO_REDIRECT_URI=

# Роли Keycloak, дающие доступ к панели
SSO_ADMIN_ROLES=tcbot-admin
SSO_VIEWER_ROLES=tcbot-viewer
# roles и groups обязательны: без них Keycloak не кладёт роли в токен
# 'roles' обязателен — без него Keycloak не положит роли в токен.
# 'groups' не нужен: роли берутся из realm_access и resource_access.
# Добавляйте 'groups' только если роли раздаются группами LDAP —
# и убедитесь, что client scope назначен клиенту, иначе будет invalid_scope.
SSO_SCOPE=openid profile email roles

SSO_SESSION_TTL=28800
# Включайте при работе по HTTPS
SSO_COOKIE_SECURE=false
# Секрет подписи cookie. Пусто = генерируется при старте (сессии сбрасываются)
SSO_SESSION_SECRET=

# ----------------------------------------------------------------------------
# ЛОКАЛЬНЫЙ АДМИНИСТРАТОР (резервный вход без Keycloak)
# ----------------------------------------------------------------------------
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=local-admin
# Пароль в открытом виде — только для первого запуска, сохраняется как хэш.
# Пусто = пароль сгенерируется и будет записан в файл ниже.
LOCAL_ADMIN_PASSWORD=
# Либо готовый хэш:
#   python -c "from tcbot.localadmin import hash_password; print(hash_password('пароль'))"
LOCAL_ADMIN_PASSWORD_HASH=
LOCAL_ADMIN_PASSWORD_FILE=local-admin-initial-password.txt

# ----------------------------------------------------------------------------
# ЛОГИРОВАНИЕ
# ----------------------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
# DEBUG-логи SDK (websockets, trueconf.client.chatbot)
WEBSOCKET_DEBUG=false

# ----------------------------------------------------------------------------
# СВЯЗЬ: HEARTBEAT, WATCHDOG, ПЕРЕПОДКЛЮЧЕНИЕ
# ----------------------------------------------------------------------------
# off    — реагируем только на события SDK
# smart  — активная проверка связи, перезапуск после 3 неудач (рекомендуется)
# strict — перезапуск сразу после первой неудачной проверки
HEARTBEAT_MODE=smart
HEARTBEAT_INTERVAL=30
WATCHDOG_INTERVAL=15
IDLE_THRESHOLD=300
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY=5
RECONNECT_BACKOFF=2.0
# Пока простой меньше окна — частые попытки, дальше — сразу потолок
RECONNECT_FAST_WINDOW=600
RECONNECT_MAX_DELAY=1800
QUIET_AFTER=600
PING_TIMEOUT=10
WS_MAX_RETRIES=5
WS_MAX_DELAY=60
SDK_TIMEOUT=15
RECEIVE_UNREAD_MESSAGES=false

# ----------------------------------------------------------------------------
# ДОСТАВКА УВЕДОМЛЕНИЙ
# ----------------------------------------------------------------------------
SEND_TIMEOUT=20
MAX_RETRIES=3
RETRY_DELAY=1.0
# Сколько ждать восстановления связи, прежде чем вернуть 503 (сек)
WEBHOOK_WAIT_TIMEOUT=20

# ----------------------------------------------------------------------------
# ОЧЕРЕДЬ НЕДОСТАВЛЕННЫХ
# ----------------------------------------------------------------------------
OUTBOX_ENABLED=true
OUTBOX_FILE=bot_outbox.json
OUTBOX_MAX_SIZE=5000
OUTBOX_TTL_HOURS=48
OUTBOX_DEDUP_WINDOW=120
OUTBOX_FLUSH_INTERVAL=5
OUTBOX_COLLAPSE=true

# ----------------------------------------------------------------------------
# ЗАЩИТА ОТ ДУБЛЕЙ ДОСТАВКИ
# ----------------------------------------------------------------------------
# Окно, в течение которого то же сообщение повторно не отправляется (сек).
# Zabbix может повторить вебхук, а сообщение уже доставлено — этот параметр
# не даёт появиться дублю в чате, в том числе после перезапуска.
DELIVERED_DEDUP_WINDOW=900

# Файл реестра доставленного (в Docker — /app/data/bot_delivered.json)
DELIVERED_FILE=bot_delivered.json

# ----------------------------------------------------------------------------
# ИСТОРИЯ МЕТРИК (графики и календарь в панели)
# ----------------------------------------------------------------------------
# Бот периодически снимает состояние: отправленные, очередь, связь, перезапуски.
# Из этих точек строятся графики, из дневной сводки — календарь активности.
# ----------------------------------------------------------------------------
# ЧАСОВОЙ ПОЯС ЛОГОВ
# ----------------------------------------------------------------------------
# В контейнере время обычно UTC, из-за чего метки в логах «съезжают»
# относительно местного времени. По умолчанию приводим к Москве (UTC+3).
LOG_TZ=3
# Если нужен UTC, раскомментируйте (перебивает LOG_TZ)
# LOG_TZ_NAME=UTC

# ----------------------------------------------------------------------------
# РЕЗЕРВНОЕ КОПИРОВАНИЕ СОСТОЯНИЯ
# ----------------------------------------------------------------------------
# Копии файла состояния: каналы, администраторы, настройки, история.
# Старые копии удаляются автоматически — хранятся последние BACKUP_KEEP.
BACKUP_ENABLED=true
BACKUP_DIR=backups

# Сколько последних копий хранить
BACKUP_KEEP=20

# Период автоматических копий в часах. 0 — только вручную из панели.
BACKUP_INTERVAL_HOURS=24

# ----------------------------------------------------------------------------
# УПРАВЛЕНИЕ СЛУЖБОЙ ИЗ ПАНЕЛИ
# ----------------------------------------------------------------------------
# Кнопка «Перезапустить службу» в меню (systemctl restart).
# Выключено по умолчанию: включайте, только если бот запущен под systemd
# и у него есть права на перезапуск своего юнита.
SERVICE_RESTART_ENABLED=false

# Имя юнита systemd (для Docker не используется)
SYSTEMD_SERVICE=trueconf-bot

# Способ перезапуска:
#   systemd — systemctl restart <служба>
#   exit    — завершить процесс; в Docker контейнер поднимется сам
#   auto    — exit внутри контейнера, иначе systemd (по умолчанию)
# В Dockerfile уже задано exit — менять не нужно.
SERVICE_RESTART_MODE=auto

# Путь к systemctl, если его нет в PATH
SYSTEMCTL_PATH=systemctl

METRICS_ENABLED=true
# В Docker переопределяется на /app/data/bot_metrics.json (том tcbot-data)
METRICS_FILE=bot_metrics.json

# Период снятия точки (сек)
METRICS_INTERVAL=60

# Период сохранения истории на диск (сек)
METRICS_SAVE_INTERVAL=300

# ----------------------------------------------------------------------------
# УДАЛЕНИЕ СООБЩЕНИЙ ОБ ОШИБКАХ
# ----------------------------------------------------------------------------
# Режим реакции при восстановлении инцидента:
#   notify  — только записать в историю (сообщение остаётся)
#   delete  — удалить сообщение о проблеме
#   resolve — отправить сообщение «восстановлено»
#   both    — удалить и отправить «восстановлено»
# Переключается в панели: Настройки -> «Что делать при восстановлении»
INCIDENT_MODE=notify

DELETE_MESSAGES_ENABLED=false
ERROR_DELETE_THRESHOLD_HOURS=24
ERROR_HISTORY_RETENTION_DAYS=7
